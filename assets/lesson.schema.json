{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognitive Learning Flow lesson v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "domain",
    "problem",
    "groundTruth",
    "scenes",
    "assessment",
    "sourceNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "statement",
        "units"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "predecessors",
              "optimistic",
              "mostLikely",
              "pessimistic"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "predecessors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optimistic": {
                "type": "number"
              },
              "mostLikely": {
                "type": "number"
              },
              "pessimistic": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "groundTruth": {
      "type": "object",
      "properties": {
        "expectedDuration": {
          "type": "number"
        },
        "criticalPaths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "criticalVariance": {
          "type": "number"
        },
        "deadline": {
          "type": "object",
          "properties": {
            "day": {
              "type": "number"
            },
            "approxProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "assumptions": {
              "type": "string"
            }
          }
        },
        "simulations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "goal",
          "rationale",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "identify",
              "understand",
              "represent",
              "plan",
              "execute",
              "verify",
              "interpret",
              "transfer"
            ]
          },
          "goal": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "write",
                    "calculator",
                    "diagram",
                    "highlight",
                    "question",
                    "reveal",
                    "visualize",
                    "scenario"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "target": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "expression": {
                  "type": "string"
                },
                "expected": {
                  "type": "number"
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "why": {
                  "type": "string",
                  "minLength": 1
                },
                "callout": {
                  "type": "string",
                  "minLength": 1
                },
                "focus": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "animation": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "write",
                        "calculate",
                        "focus",
                        "draw",
                        "predict",
                        "verify"
                      ]
                    }
                  }
                },
                "visualizationId": {
                  "type": "string"
                },
                "reveal": {
                  "type": "integer",
                  "minimum": 0
                },
                "scenarioId": {
                  "type": "string",
                  "minLength": 1
                },
                "frames": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 90
                }
              }
            }
          },
          "checkpoint": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "answer": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "tolerance": {
                "type": "number"
              },
              "hint": {
                "type": "string"
              },
              "feedback": {
                "type": "string"
              },
              "hints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 5
              },
              "misconceptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "feedback"
                  ],
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "feedback": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "stem",
              "options",
              "correctOptionId",
              "explanation"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "stem": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text",
                    "feedback"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "feedback": {
                      "type": "string"
                    }
                  }
                }
              },
              "correctOptionId": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sourceNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visualizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "simulations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "inventory-eoq",
              "queue-mm1",
              "production-line"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "min",
                "max",
                "step"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "sensitivity": {
            "type": "object",
            "required": [
              "parameter",
              "min",
              "max"
            ],
            "properties": {
              "parameter": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
