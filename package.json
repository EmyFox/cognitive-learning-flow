{
  "name": "cognitive-learning-flow",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone reusable skill for visual problem-solving learning experiences",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
