{
  "name": "cognitive-learning-flow",
  "version": "0.13.0",
  "private": true,
  "description": "Explanation-first notebook lessons with fully visible microsteps, optional autoplay, and no required quizzes",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:example": "node scripts/validate-lesson.mjs examples/pert-cpm.lesson.json",
    "build:example": "node scripts/build-html.mjs examples/pert-cpm.lesson.json dist/pert-cpm.html",
    "build:html": "node scripts/build-html.mjs",
    "build:resources": "node scripts/build-resources.mjs examples/pert-cpm.lesson.json dist/kit",
    "build:integrated": "node scripts/integrate-html.mjs examples/existing-page.html examples/pert-cpm.lesson.json dist/existing-integrated.html --force",
    "validate:forecast": "node scripts/validate-lesson.mjs examples/forecast-moving-average.lesson.json",
    "build:forecast:resources": "node scripts/build-resources.mjs examples/forecast-moving-average.lesson.json dist/forecast-kit",
    "build:forecast:integrated": "node scripts/integrate-html.mjs examples/forecast-host.html examples/forecast-moving-average.lesson.json dist/forecast-integrated.html --force",
    "validate:operations": "node scripts/validate-lesson.mjs examples/operations-lab.lesson.json",
    "build:operations": "node scripts/integrate-html.mjs examples/operations-host.html examples/operations-lab.lesson.json dist/operations-integrated.html --force",
    "build:operations:resources": "node scripts/build-resources.mjs examples/operations-lab.lesson.json dist/operations-kit",
    "validate:school": "node scripts/validate-school.mjs examples/line-balancing.school.json",
    "build:school": "node scripts/build-school-demo.mjs examples/line-balancing.school.json examples/school-notebook-host.html dist/school-line-balancing.html",
    "build:neutral": "node scripts/build-html.mjs examples/pert-cpm.lesson.json dist/pert-cpm-neutral.html --theme neutral",
    "build:ink-demo": "node scripts/build-school-demo.mjs examples/line-balancing.school.json examples/school-notebook-host.html dist/school-line-balancing.html",
    "build:fluent": "node scripts/integrate-html.mjs examples/smooth-classroom-host.html examples/pert-cpm.lesson.json dist/fluent-classroom.html --force",
    "build:mental": "node scripts/build-mental-tutor.mjs examples/eoq-mental-tutor.json dist/eoq-mental-tutor.html --force"
  }
}
